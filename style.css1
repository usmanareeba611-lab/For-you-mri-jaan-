/* ==========================
   Google Font & Reset
========================== */

@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap');

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:'Poppins',sans-serif;
    overflow-x:hidden;
    background:linear-gradient(135deg,#ffd6e7,#ffe9f3,#fff5fa);
    color:#444;
    min-height:100vh;
}

/* ==========================
   Animated Background
========================== */

.background{
    position:fixed;
    inset:0;
    z-index:-2;
    background:
    radial-gradient(circle at top left,#ffffffaa 0%,transparent 30%),
    radial-gradient(circle at bottom right,#ffd6ea 0%,transparent 35%),
    linear-gradient(135deg,#ffd6e7,#ffeef7,#fff8fb);
}

/* Floating circles */

.background::before,
.background::after{
    content:"";
    position:absolute;
    border-radius:50%;
    filter:blur(50px);
    animation:float 10s ease-in-out infinite;
}

.background::before{
    width:220px;
    height:220px;
    background:#ffc6dc;
    top:10%;
    left:-50px;
}

.background::after{
    width:300px;
    height:300px;
    background:#ffe4ef;
    bottom:-80px;
    right:-80px;
}

@keyframes float{

0%,100%{
transform:translateY(0);
}

50%{
transform:translateY(-30px);
}

}

/* ==========================
   Page Layout
========================== */

.page{

width:90%;
max-width:800px;

margin:80px auto;

padding:40px;

background:rgba(255,255,255,.35);

backdrop-filter:blur(18px);

border-radius:30px;

box-shadow:0 15px 35px rgba(0,0,0,.15);

display:none;

animation:fade .8s ease;

}

.page.active{

display:block;

}

@keyframes fade{

from{

opacity:0;

transform:translateY(40px);

}

to{

opacity:1;

transform:translateY(0);

}

}

/* ==========================
   Headings
========================== */

h1,h2{

text-align:center;

color:#ff4f8b;

margin-bottom:20px;

}

p{

line-height:1.9;

font-size:18px;

margin-bottom:15px;

text-align:center;

}
/* ==========================
   Buttons
========================== */

.next{
    display:block;
    margin:35px auto 10px;
    padding:15px 35px;
    border:none;
    border-radius:50px;
    background:linear-gradient(135deg,#ff6fa5,#ff8fbd);
    color:#fff;
    font-size:17px;
    font-weight:600;
    cursor:pointer;
    transition:.35s;
    box-shadow:0 10px 25px rgba(255,105,160,.35);
}

.next:hover{
    transform:translateY(-4px) scale(1.05);
    box-shadow:0 18px 35px rgba(255,105,160,.45);
}

.next:active{
    transform:scale(.95);
}

/* ==========================
   Promise Box
========================== */

.rules{
    background:#ffffff70;
    padding:25px;
    border-radius:20px;
    margin:25px 0;
}

.rules p{
    text-align:left;
    font-size:18px;
    margin:15px 0;
}

/* ==========================
   Loading Bar
========================== */

.loader{
    width:100%;
    height:18px;
    background:#ffe3ee;
    border-radius:50px;
    overflow:hidden;
    margin:30px 0;
}

.bar{
    width:0%;
    height:100%;
    border-radius:50px;
    background:linear-gradient(90deg,#ff4f8b,#ff8eb8);
    animation:loading 4s forwards;
}

@keyframes loading{

0%{
width:0%;
}

20%{
width:20%;
}

45%{
width:45%;
}

70%{
width:70%;
}

90%{
width:90%;
}

100%{
width:100%;
}

}

/* ==========================
   Smile Meter
========================== */

.meter{
    width:100%;
    height:22px;
    background:#ffe5ef;
    border-radius:50px;
    overflow:hidden;
    margin:30px 0;
}

.fill{
    width:12%;
    height:100%;
    border-radius:50px;
    background:linear-gradient(90deg,#ff4f8b,#ffb1ce);
    animation:smileGrow 5s infinite alternate;
}

@keyframes smileGrow{

0%{
width:12%;
}

50%{
width:65%;
}

100%{
width:100%;
}

}

/* ==========================
   Glass Cards
========================== */

.card{
    background:rgba(255,255,255,.45);
    backdrop-filter:blur(15px);
    border-radius:22px;
    padding:22px;
    margin:20px 0;
    transition:.35s;
    box-shadow:0 10px 25px rgba(0,0,0,.08);
}

.card:hover{
    transform:translateY(-8px);
    box-shadow:0 18px 35px rgba(0,0,0,.12);
/* ==========================
   Floating Hearts
========================== */

.hearts{
    position:fixed;
    inset:0;
    overflow:hidden;
    pointer-events:none;
    z-index:-1;
}

.heart{
    position:absolute;
    bottom:-50px;
    color:#ff6fa5;
    font-size:22px;
    animation:heartFloat linear infinite;
    opacity:.8;
}

@keyframes heartFloat{

0%{
transform:translateY(0) rotate(0deg);
opacity:0;
}

15%{
opacity:1;
}

100%{
transform:translateY(-120vh) rotate(360deg);
opacity:0;
}

}

/* ==========================
   Twinkling Stars
========================== */

.star{
    position:absolute;
    width:4px;
    height:4px;
    background:white;
    border-radius:50%;
    animation:twinkle 2s infinite;
}

@keyframes twinkle{

0%,100%{
opacity:.2;
transform:scale(.8);
}

50%{
opacity:1;
transform:scale(1.8);
}

}

/* ==========================
   Popup Box
========================== */

.popup{

position:fixed;

top:50%;

left:50%;

transform:translate(-50%,-50%) scale(.8);

width:90%;
max-width:420px;

background:white;

padding:30px;

border-radius:25px;

box-shadow:0 20px 50px rgba(0,0,0,.25);

text-align:center;

visibility:hidden;

opacity:0;

transition:.4s;

z-index:1000;

}

.popup.show{

visibility:visible;

opacity:1;

transform:translate(-50%,-50%) scale(1);

}

.popup h3{

color:#ff4f8b;

margin-bottom:15px;

}

.popup button{

margin-top:20px;

}

/* ==========================
   Confetti
========================== */

.confetti{

position:fixed;

width:12px;

height:12px;

top:-20px;

animation:confettiFall linear forwards;

}

@keyframes confettiFall{

0%{

transform:translateY(0) rotate(0deg);

}

100%{

transform:translateY(120vh) rotate(720deg);

}

}

/* ==========================
   Cute Cards
========================== */

.card-title{

font-size:22px;

font-weight:700;

color:#ff4f8b;

margin-bottom:10px;

}

.card-text{

font-size:17px;

line-height:1.8;

}

/* ==========================
   Hidden Surprise Button
========================== */

.secret-btn{

background:#ffffff;

color:#ff4f8b;

border:2px dashed #ff8ab7;

padding:14px 25px;

border-radius:40px;

cursor:pointer;

transition:.3s;

}

.secret-btn:hover{

background:#ffedf5;

transform:scale(1.05);
/* ==========================
   Gift Box
========================== */

.gift-box{
    width:140px;
    height:140px;
    margin:30px auto;
    background:linear-gradient(135deg,#ff8fb8,#ff5d98);
    border-radius:20px;
    position:relative;
    cursor:pointer;
    transition:.4s;
    animation:giftBounce 2s infinite;
}

.gift-box::before{
    content:"";
    position:absolute;
    width:24px;
    height:140px;
    background:#fff;
    left:50%;
    transform:translateX(-50%);
}

.gift-box::after{
    content:"🎀";
    position:absolute;
    top:-28
}
